# Entity: server

main: kit: entity: server: {

  alias: field: {}

  fields: [
    {
      name: "country"
      req: false
      short: "Country code of the server location"
      type: "`$STRING`"
    }
    {
      name: "host"
      req: false
      short: "Server hostname or IP address"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the server"
      type: "`$STRING`"
    }
    {
      name: "location"
      req: false
      short: "Geographic location of the server"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Display name of the server"
      type: "`$STRING`"
    }
    {
      name: "port"
      req: false
      short: "Server port number"
      type: "`$INTEGER`"
    }
    {
      name: "protocol"
      req: false
      short: "VPN protocol used by the server"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "server"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/01c6b4d1fccf-thankful-aisling/ext_config/remote-config.json"
          parts: [
            "01c6b4d1fccf-thankful-aisling"
            "ext_config"
            "remote-config.json"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.servers`"
          }
        }
      ]
    }
  }



}
